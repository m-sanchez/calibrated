{
  "name": "@m-sanchez/calibrated",
  "version": "2.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Is your model's confidence honest? ECE, Brier decomposition, reliability diagrams, and temperature scaling - zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CLAIMS.md",
    "NUMERICAL_REVIEW.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "demo": "node demo/demo.ts",
    "floor": "node demo/floor.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-sanchez/calibrated.git"
  },
  "homepage": "https://github.com/m-sanchez/calibrated#readme",
  "bugs": {
    "url": "https://github.com/m-sanchez/calibrated/issues"
  },
  "author": "Miguel Sanchez <contact@miguelsanchez.co.uk>",
  "license": "MIT",
  "keywords": [
    "calibration",
    "ece",
    "brier-score",
    "reliability-diagram",
    "temperature-scaling",
    "uncertainty",
    "confidence",
    "machine-learning",
    "evaluation"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.0"
  }
}
